@import "layoutVars"

.g-header-wrapper
  height $headerHeight
  padding 0 15px

:where(html:not(.g-ui-htk)) .g-header-wrapper
  vertical-align middle

.g-app-title
  display inline
  font-size 25px
  margin-right 35px
  line-height $headerHeight
  cursor pointer

:where(html:not(.g-ui-htk)) .g-app-title
  font-weight bold

.g-quick-search-form
  display inline-block
  margin-right 12px
  vertical-align top
  margin-top (($headerHeight - 30px) / 2)
  width $quickSearchWidth

.g-current-user-wrapper
  display inline
  float right

@media (max-width 720px)
  .g-app-title
    display none
