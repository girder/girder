  "repository": {
    "type": "git",
    "url": "git+https://github.com/girder/girder.git"
  },
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "main": "./dist/girder-plugin-local-checkout.umd.cjs",
