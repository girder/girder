{
  "name": "@girder/girder-plugin-local-checkout",
  "version": "0.0.0",
  "description": "Temporarily copies S3 assetstore data to a filesystem assetstore.",
  "homepage": "http://girder.readthedocs.io/en/latest/plugins.html#local-checkout",
  "bugs": {
